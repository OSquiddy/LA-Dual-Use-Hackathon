# Copy to frontend/.env.local
# fixture = render src/fixtures/*.json (no backend needed) · live = poll the backend
VITE_API=live
# Local: Vite proxies /api to this URL. Render Static Site: bake the public backend origin
# (e.g. https://handoffproof-api.onrender.com) so the browser calls it directly.
VITE_BACKEND_URL=http://127.0.0.1:8001
