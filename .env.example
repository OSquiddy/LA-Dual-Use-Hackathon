# Copy to .env at the repo root (never commit .env). The backend reads it on startup.

# Retell (A fills these in; share through the team password manager, not chat)
RETELL_API_KEY=
RETELL_FROM_NUMBER=
RETELL_INTAKE_AGENT_ID=
RETELL_CALLBACK_AGENT_ID=

# Public tunnel URL of whoever is running the backend (cloudflared / ngrok)
PUBLIC_BASE_URL=

# simulate = fake callbacks, no Retell needed · live = real outbound calls
CALL_MODE=simulate
# demo = ladder steps in seconds (stage) · real = minutes
TIMING_PROFILE=demo

# Default: backend/handoffproof.db
DB_PATH=

# The teammate's phone that plays the resident in the live callback (E.164, e.g. +12135550123)
DEMO_RESIDENT_PHONE=

# Optional. The engine must work without it.
LLM_API_KEY=

# Comma-separated, or * for any
CORS_ORIGINS=*
