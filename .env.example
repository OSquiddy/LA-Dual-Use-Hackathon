# Copy to .env at the repo root (never commit .env). The backend reads it on startup.

# Retell (A fills these in; share through the team password manager, not chat)
RETELL_API_KEY=
RETELL_FROM_NUMBER=
RETELL_INTAKE_AGENT_ID=
RETELL_CALLBACK_AGENT_ID=

# Separate strong secret for evidence, human responsibility actions and callback controls.
# Leave blank to disable these actions. Never put this in frontend/VITE_* configuration.
REVIEWER_API_KEY=

# Public tunnel URL pointing ONLY to the webhook gateway on port 8002 (cloudflared / ngrok)
PUBLIC_BASE_URL=

# simulate = fake callbacks, no Retell needed · live = real outbound calls
CALL_MODE=simulate
# Separate live automation gate. Keep 0 for simulation and a manually confirmed one-call test.
# In an authorized live process, changing this to 0 stops new automatic dispatches
# without a restart. Setting it back to 1 resumes overdue eligible incidents.
LIVE_CALLBACKS_ENABLED=0
MAX_CALLBACK_ATTEMPTS=2
CALLBACK_RESULT_TIMEOUT_S=180
# demo = ladder steps in seconds (stage) · real = minutes
TIMING_PROFILE=demo

# Default: backend/handoffproof.db
DB_PATH=

# Optional synthetic seed contact (E.164). Seed permissions authorize simulation only.
# Live callbacks use the consenting Retell intake report's stored caller number.
DEMO_RESIDENT_PHONE=

# Optional. The engine must work without it.
LLM_API_KEY=

# Comma-separated, or * for any
CORS_ORIGINS=*
